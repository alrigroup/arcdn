ALRIGROUP@APPMAKE
{
  "name": "arcdn",
  "bin": "arcdn.arapp",
  "version": "0.2.01",
  "runtime": "native",
  "entry": "cdn_web",
  "platforms": {
    "windows": {
      "entry": "cdn_web"
    },
    "linux": {
      "entry": "cdn_web"
    },
    "linux-x64": {
      "entry": "cdn_web"
    },
    "linux-arm64": {
      "entry": "cdn_web"
    }
  },
  "build": {
    "staging": "$ARCORE/.staging/$APP_NAME",
    "steps": [
      {
        "name": "cc",
        "cmd": "cc -O2 -Isrc -Isrc/os/include -I$ARCORE/include -o $STAGING/cdn_web src/cdn_server.c src/os/main.c -L$ARCORE/lib -larkernel -lssl -lcrypto -lpthread"
      }
    ],
    "cleanup": []
  },
  "files": [
    "cdn_web"
  ],
  "description": "Motor de Distribuicao Estatica e Streaming de Midia",
  "commands": [
    "status",
    "routes",
    "list",
    "add <path> <file>",
    "del <path>",
    "ping"
  ]
}
